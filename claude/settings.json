{
    "model": "opusplan",
    "tui": "fullscreen",
    "extraKnownMarketplaces": {
        "claude-plugins-official": {
            "source": {
                "source": "github",
                "repo": "anthropics/claude-plugins-official"
            }
        }
    },
    "hooks": {
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "${XDG_DATA_HOME:-$HOME/.local/share}/tmux/plugins/tmux-agent-status-*/hooks/better-hook.sh UserPromptSubmit"
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "${XDG_DATA_HOME:-$HOME/.local/share}/tmux/plugins/tmux-agent-status-*/hooks/better-hook.sh PreToolUse"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "${XDG_DATA_HOME:-$HOME/.local/share}/tmux/plugins/tmux-agent-status-*/hooks/better-hook.sh Stop"
                    }
                ]
            }
        ],
        "Notification": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "${XDG_DATA_HOME:-$HOME/.local/share}/tmux/plugins/tmux-agent-status-*/hooks/better-hook.sh Notification"
                    }
                ]
            }
        ]
    },
    "permissions": {
        "allow": [
            "Bash(git fetch *)"
        ]
    }
}
