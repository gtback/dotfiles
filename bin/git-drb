#!/bin/bash

# Delete branches whose upstream branch is gone ("removed" branches)

# Run with `git drb`

set -euo pipefail

git remote | xargs git remote prune

# Never delete a branch that is checked out in any worktree (including the
# current one).
git for-each-ref refs/heads/ "--format=%(refname:short) %(upstream:track) %(worktreepath)" \
    | while read -r branch track worktree; do
        if [[ "$track" != "[gone]" ]]; then
            continue
        fi
        if [[ -n "$worktree" ]]; then
            echo >&2 "Skipping $branch (checked out in $worktree)"
            continue
        fi
        git branch -D "$branch"
    done
