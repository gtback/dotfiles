#!/bin/bash

# Delete branches that have been squash-merged into the remote HEAD branch
# (usually `main` or `master`).

# From: https://github.com/not-an-aardvark/git-delete-squashed

# Run with `git dsb`

# shellcheck source=../sh/git.sh
source "${XDG_CONFIG_HOME}/sh/git.sh"

set -euo pipefail

remote=${GIT_DSB_REMOTE:-origin}

head=$(git.remote-head "$remote")
if [[ -z "$head" ]]; then
    echo >&2 "Cannot resolve HEAD branch for '${remote}'. Run: git remote set-head ${remote} --auto"
    exit 1
fi
head_ref="remotes/$remote/$head"

# Track current branch so we never delete it out from under ourselves.
current=$(git symbolic-ref --short HEAD 2>/dev/null || true)

git for-each-ref refs/heads/ "--format=%(refname:short)" \
    | while read -r branch; do
        if [[ "$branch" == "$head" ]]; then
            continue
        fi
        if [[ -n "$current" && "$branch" == "$current" ]]; then
            echo >&2 "Skipping $branch (currently checked out)"
            continue
        fi
        mergeBase=$(git merge-base "$head_ref" "$branch" 2>/dev/null) || continue
        echo "Checking ${branch}"
        [[ $(git cherry "$head_ref" "$(git commit-tree "$(git rev-parse "$branch"^\{tree\})" -p "$mergeBase" -m _)") == "-"* ]] \
            && git branch -D "$branch"
    done
