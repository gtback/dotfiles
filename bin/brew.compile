"""Compile an enhanced Brewfile (see lib/pkgs/brewfile.py) for homebrew-bundle."""

import logging
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from pkgs.brewfile import compile  # noqa: E402

logging.basicConfig()

if __name__ == "__main__":
    for entry in compile(sys.argv[1]):
        print(entry.line)
