# Compare installed VS Code extensions against the configured list.
# Respects $CODE_EXTENSION_PROFILES when called with no arguments.
#
# Usage: code.diff [profile ...]
# Example: code.diff elastic

set -euo pipefail

# shellcheck source=../sh/code.sh
source "${XDG_CONFIG_HOME}/sh/code.sh"

installed=$(code --list-extensions | sort)
configured=$(code.configured-extensions "$@")

echo "Installed but not in configured list:"
comm -23 <(echo "$installed") <(echo "$configured")

echo
echo "In configured list but not installed:"
comm -13 <(echo "$installed") <(echo "$configured")
